# Copy to .env and fill in local values. Never commit .env.
#
#   cp .env.example .env
#
# Real contact addresses, paid API tokens, and deployment credentials belong
# in Codespaces secrets or repository environment secrets, not in this file.

# Environment name: development | test | production
STORMROUTE_ENV=development

# Root of the data layers, relative to the repository root.
STORMROUTE_DATA_DIR=data

# Trained model artifact consumed by the API.
STORMROUTE_MODEL_PATH=artifacts/models/stormroute_model.joblib

# Browser origins allowed to call the API. Comma-separated, exact origins;
# replace these with deployed frontend origins in production. Wildcards fail
# validation. Defaults to these two Vite development origins if unset.
STORMROUTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The NWS API requires a descriptive User-Agent with a contact address.
# Replace contact@example.com with a real address before any live API call.
NWS_USER_AGENT=StormRoute/0.1 contact@example.com

# Routing backend. The public OSRM demo server is rate limited and must not
# be relied on during judging; the stage demo replays cached routes.
ROUTING_BASE_URL=https://router.project-osrm.org

# OpenRouteService: place search and reverse lookup for the trip planner
# (turning a typed destination, or the browser's GPS location, into
# coordinates). Free key: openrouteservice.org/dev/#/signup. Routing itself
# stays on OSRM above; this is geocoding only. Without it, /api/v1/geocode/*
# returns 503 rather than failing to start.
ORS_API_KEY=

# Base URL the frontend uses to reach the API.
VITE_API_BASE_URL=http://localhost:8000
